# ── Datenbank ──────────────────────────────────────────────
POSTGRES_USER=alma
POSTGRES_PASSWORD=SICHERES_PASSWORT_HIER
POSTGRES_DB=alma

# ── Sicherheit ─────────────────────────────────────────────
# Zufälligen String generieren: openssl rand -hex 32
SECRET_KEY=ZUFAELLIGEN_SECRET_KEY_HIER_EINTRAGEN

# ── KI-APIs (optional) ─────────────────────────────────────
# Nur nötig wenn PDF-Import-Funktion genutzt wird
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# ── Player-URL für Orbis-Integration ───────────────────────────────
# IP oder Hostname des ALMA-Servers, wie er vom Orbis-Rechner erreichbar ist
ALMA_PUBLIC_URL=http://ZIEL_IP
